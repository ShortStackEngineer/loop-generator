{
  "name": "loop-generator",
  "version": "0.1.1",
  "description": "The loop runner that doesn't believe the agent: drive a coding agent against your checks and get a verifiable report — with spec/test tamper guards, baseline checks, and budget ceilings.",
  "type": "module",
  "bin": {
    "loopgen": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "loopgen": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run"
  },
  "homepage": "https://shortstackengineer.github.io/loop-generator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShortStackEngineer/loop-generator.git"
  },
  "keywords": [
    "agent",
    "claude",
    "feedback-loop",
    "codegen",
    "evaluation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "commander": "^13.0.0",
    "yaml": "^2.6.1",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
